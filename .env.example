# Copy this file to .env on the server (or set these as Environment
# Variables in cPanel's "Setup Node.js App" panel — either works; the
# panel's own env vars take priority if both are set) and fill in real
# production values. Never commit a real .env — it's gitignored on
# purpose. See DEPLOY.md for the full deployment walkthrough.

# --- Database (required) ---
# Production PostgreSQL connection string. Most cPanel hosts provide
# PostgreSQL via "PostgreSQL Databases" in cPanel, or you may be using
# an external managed Postgres (Neon, Supabase, RDS, etc.) — either
# works, just needs to be reachable from the server this app runs on.
DATABASE_URL=""

# --- Session security (required) ---
# SIWE session signing secret. Generate a real random value for
# production — do NOT reuse the dev placeholder. Example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Real BEP20 USDT deposits (BNB Smart Chain) ---
# Your treasury/cold wallet's receiving address on BSC. Leave empty to
# keep the deposit feature inert/unconfigured.
TREASURY_BEP20_ADDRESS=""
BSC_RPC_URL="https://1rpc.io/bnb"
NEXT_PUBLIC_BSC_RPC_URL="https://1rpc.io/bnb"
# Official Binance-Peg USDT (BEP20) token contract on BSC mainnet —
# only change this if intentionally deposit-testing on BSC testnet.
BEP20_USDT_CONTRACT="0x55d398326f99059fF775485246999027B3197955"
MIN_BEP20_CONFIRMATIONS="15"

# Shared secret an external cron job must send as
# `Authorization: Bearer <value>` to trigger /api/wallet/deposit-watch.
# Generate a real random value — see DEPLOY.md for how to set up the
# cron job itself (cPanel's "Cron Jobs" tool).
DEPOSIT_CRON_SECRET=""

# --- Admin dashboard (/admin) ---
# Comma-separated lowercased EVM addresses allowed into /admin and
# /api/admin/*. Empty means nobody can access /admin (safe default,
# but you'll want at least one address here to actually administer
# the platform).
ADMIN_ADDRESSES=""

# Your real production domain (no trailing slash). Used when building
# shareable links (lobby invites, referral links).
NEXT_PUBLIC_APP_URL="https://spacedoge.games"

# --- Web Push notifications (lobby invite/accept/decline) ---
# Generate a real production pair with: npx web-push generate-vapid-keys
# Public key is duplicated under NEXT_PUBLIC_ on purpose (read
# client-side to subscribe the browser) — same value, two names.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:admin@spacedoge.games"

# --- WalletConnect (mobile wallet connect) ---
# Free Project ID from https://cloud.reown.com — without this, mobile
# browser tabs (Safari/Chrome, not a wallet app's own in-app browser)
# can't connect at all.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
